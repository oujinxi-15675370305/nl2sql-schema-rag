LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 分析模式可选配置：Planner/Synthesizer 用的模型，留空则同 LLM_MODEL；SQL 生成仍用 LLM_MODEL
# 当前账号 /models 只有 deepseek-flash / deepseek-v4-pro，deepseek-reasoner 别名会路由到 flash
ANALYSIS_MODEL=
# 分析模型接另一家 OpenAI 兼容服务时填（如千问 DashScope）；留空则复用 LLM_BASE_URL / LLM_API_KEY
# 实测 qwen3.8-flash 质量 3/3 但平均 40s/题，需 ANALYSIS_TIMEOUT_S>=60，只适合可选的深分析
# 注意：ANALYSIS_API_KEY 不要提交，.env 已在 .gitignore
ANALYSIS_BASE_URL=
ANALYSIS_API_KEY=
# 分析模式单次模型调用超时（秒）与总预算（秒，从 Planner 开始计时；耗尽后不调综合模型）
ANALYSIS_TIMEOUT_S=30
ANALYSIS_TOTAL_BUDGET_S=60
# 分析模式每步 SQL 最大重试次数（0–2；低于快路径的 2）
ANALYSIS_STEP_MAX_REPAIR=1
HOST=127.0.0.1
PORT=8000
