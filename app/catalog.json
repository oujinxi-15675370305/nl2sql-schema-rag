{
  "relations": [
    ["orders.customer_id", "customers.customer_id"],
    ["orders.region_id", "regions.region_id"],
    ["order_items.order_id", "orders.order_id"],
    ["order_items.product_id", "products.product_id"],
    ["repurchase_customers.customer_id", "customers.customer_id"],
    ["repurchase_customers.region_id", "regions.region_id"]
  ],
  "instructions": {
    "share": "本次是份额/占比问题：分子和分母必须同源。品牌/品类销售额用可加的行级口径（SUM(i.item_amount) 或按明细分摊整单金额），地区总额也用同一口径；不要用整单 pay_amount 当分母去配 item_amount 分子。",
    "repurchase": "复购客户可以直接查 repurchase_customers（customer_id, region_id, order_count），用客户所属地区，不要按订单地区拆客户。这张表只有客户/地区/订单数：按品类/品牌/商品拆要回 orders + order_items + products 明细聚合；按 GMV/金额阈值筛只用 orders 的整单 pay_amount（按 customer_id 聚合后 HAVING），不要 join order_items——整单金额会被明细行重复计入。复购客户数直接 COUNT(DISTINCT repurchase_customers.customer_id)，不要为了 customer_count 指标强行 join customers。"
  },
  "tables": [
    {
      "name": "orders",
      "comment": "订单主表，一行一个订单",
      "synonyms": ["订单", "下单", "交易"],
      "columns": [
        {"name": "order_id", "type": "TEXT", "comment": "订单号", "is_dimension": true},
        {"name": "customer_id", "type": "TEXT", "comment": "客户编号", "is_dimension": true},
        {"name": "region_id", "type": "INTEGER", "comment": "地区编号", "is_dimension": true},
        {"name": "order_date", "type": "TEXT", "comment": "下单日期 YYYY-MM-DD", "synonyms": ["下单时间", "日期", "时间"], "is_dimension": true},
        {"name": "status", "type": "TEXT", "comment": "订单状态 paid/refunded/cancelled", "synonyms": ["状态"], "is_dimension": true},
        {"name": "pay_amount", "type": "REAL", "comment": "实付金额（元）", "synonyms": ["金额", "实付", "支付金额"], "is_measure": true},
        {"name": "refund_amount", "type": "REAL", "comment": "退款金额（元）", "synonyms": ["退款"], "is_measure": true},
        {"name": "cost_amount", "type": "REAL", "comment": "成本金额（元）", "synonyms": ["成本"], "is_measure": true}
      ]
    },
    {
      "name": "order_items",
      "comment": "订单明细，一行一个商品",
      "synonyms": ["明细", "商品明细"],
      "columns": [
        {"name": "order_id", "type": "TEXT", "comment": "订单号", "is_dimension": true},
        {"name": "product_id", "type": "TEXT", "comment": "商品编号", "is_dimension": true},
        {"name": "quantity", "type": "INTEGER", "comment": "数量", "synonyms": ["件数", "销量"], "is_measure": true},
        {"name": "unit_price", "type": "REAL", "comment": "单价（元）", "synonyms": ["单价", "价格"], "is_measure": true},
        {"name": "item_amount", "type": "REAL", "comment": "明细金额（元）", "synonyms": ["行金额"], "is_measure": true}
      ]
    },
    {
      "name": "products",
      "comment": "商品主数据",
      "synonyms": ["商品", "产品", "SKU"],
      "columns": [
        {"name": "product_id", "type": "TEXT", "comment": "商品编号", "is_dimension": true},
        {"name": "product_name", "type": "TEXT", "comment": "商品名称", "synonyms": ["名称", "品名"], "is_dimension": true},
        {"name": "category", "type": "TEXT", "comment": "商品品类", "synonyms": ["品类", "类目", "分类"], "is_dimension": true},
        {"name": "brand", "type": "TEXT", "comment": "品牌", "is_dimension": true},
        {"name": "list_price", "type": "REAL", "comment": "标价（元）", "synonyms": ["标价"], "is_measure": true}
      ]
    },
    {
      "name": "regions",
      "comment": "地区维表",
      "synonyms": ["地区", "区域", "大区"],
      "columns": [
        {"name": "region_id", "type": "INTEGER", "comment": "地区编号", "is_dimension": true},
        {"name": "region_name", "type": "TEXT", "comment": "地区名称（华东/华南/华北/西南）", "synonyms": ["地区名", "大区名"], "is_dimension": true}
      ]
    },
    {
      "name": "repurchase_customers",
      "comment": "复购客户（已支付订单数 >= 2），一行一个客户；按客户所属地区统计",
      "synonyms": ["复购客户", "复购", "回头客", "复购名单", "复购客户数",
                   "下过至少两单", "下过至少2单", "至少两单", "至少2单",
                   "两单以上", "2单以上", "买过两次", "多次购买"],
      "columns": [
        {"name": "customer_id", "type": "TEXT", "comment": "客户编号", "is_dimension": true},
        {"name": "region_id", "type": "INTEGER", "comment": "客户所属地区编号", "is_dimension": true},
        {"name": "order_count", "type": "INTEGER", "comment": "已支付订单数", "is_measure": true}
      ]
    },
    {
      "name": "customers",
      "comment": "客户主数据，一行一个客户",
      "synonyms": ["客户", "顾客", "会员"],
      "columns": [
        {"name": "customer_id", "type": "TEXT", "comment": "客户编号", "is_dimension": true},
        {"name": "region_id", "type": "INTEGER", "comment": "地区编号", "is_dimension": true},
        {"name": "customer_name", "type": "TEXT", "comment": "客户名称", "synonyms": ["客户名", "客户名单"], "is_dimension": true},
        {"name": "customer_phone", "type": "TEXT", "comment": "手机号（敏感列）", "synonyms": ["手机号", "电话", "手机", "联系方式"], "sensitive": true}
      ]
    }
  ],
  "metrics": [
    {"name": "gmv", "comment": "成交总额：已支付订单的实付金额之和", "synonyms": ["GMV", "gmv", "成交额", "销售额", "营收", "交易额"], "requires": ["orders.pay_amount"], "sql": "SUM(o.pay_amount)", "additive": true, "grain": "order", "warning": "整单口径；按品类/品牌拆分需订单行分摊，不能直接相加"},
    {"name": "order_count", "comment": "订单数：已支付订单的数量", "synonyms": ["订单数", "单量", "订单量", "多少单"], "requires": ["orders.order_id"], "sql": "COUNT(DISTINCT o.order_id)", "additive": true, "grain": "order"},
    {"name": "aov", "comment": "客单价：成交总额 / 订单数", "synonyms": ["客单价", "平均订单金额", "均价"], "requires": ["orders.pay_amount"], "sql": "ROUND(SUM(o.pay_amount) * 1.0 / COUNT(DISTINCT o.order_id), 2)", "additive": false, "grain": "order", "warning": "比率指标，不能跨组相加或直接平均"},
    {"name": "refund_rate", "comment": "退款率：退款订单数 / 全部订单数（按订单当前状态统计）", "synonyms": ["退款率", "退货率"], "requires": ["orders.refund_amount"], "sql": "ROUND(SUM(CASE WHEN o.status = 'refunded' THEN 1 ELSE 0 END) * 1.0 / COUNT(DISTINCT o.order_id), 4)", "additive": false, "grain": "order", "warning": "比率指标，不能跨组相加或直接平均"},
    {"name": "units", "comment": "销量：商品件数之和", "synonyms": ["销量", "件数", "卖了多少件"], "requires": ["order_items.quantity"], "sql": "SUM(i.quantity)", "additive": true, "grain": "order_item"},
    {"name": "customer_count", "comment": "客户数：有成交的客户数（按客户去重）", "synonyms": ["客户数", "客户数量", "多少客户", "多少个客户", "客户人数"], "requires": ["customers.customer_id"], "sql": "COUNT(DISTINCT c.customer_id)", "additive": false, "grain": "customer", "warning": "去重计数，跨组求和可能重复计算客户"}
  ]
}
